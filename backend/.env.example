# Copy to .env. Every value has a working default for local development.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=truthshield
# Fall back to an in-memory database when MongoDB is unreachable. Set false in production.
ALLOW_MOCK_DB=true
# Required in production; a random per-process secret is generated when empty.
JWT_SECRET=
JWT_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
ENABLE_BROWSER=true
ENABLE_CT_WATCH=true
# Optional: raises the free api.certspotter.com hourly limit.
CERTSPOTTER_API_KEY=
SEED_DEMO_DATA=true
